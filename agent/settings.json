{
  "lastChangelogVersion": "0.84.3",
  "packages": [
    "npm:pi-ollama-cloud",
    "npm:@ifi/oh-pi-themes",
    "npm:pi-simplify",
    "npm:pi-compass",
    "npm:@dreki-gg/pi-context7",
    "git:github.com/badlogic/pi-mono",
    "npm:@aliou/pi-guardrails",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-powerline-footer",
    "./agent/extensions/pi-ouranos-gitea",
    "./agent/extensions/pi-ouranos-github",
    "./agent/extensions/pi-ouranos-modes",
    "./agent/extensions/pi-ouranos-todo"
  ],
  "defaultProvider": "ollama-cloud",
  "defaultModel": "kimi-k3",
  "subagents": {
    "asyncByDefault": true,
    "control": {
      "enabled": true,
      "needsAttentionAfterMs": 300000,
      "activeNoticeAfterMs": 600000
    }
  },
  "theme": "catppuccin-mocha",
  "defaultThinkingLevel": "xhigh",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 24000
  },
  "powerline": {
    "customItems": [
      {
        "id": "mode",
        "statusKey": "mode",
        "position": "right",
        "color": "accent",
        "hideWhenMissing": true
      }
    ]
  },
  "modePrefs": {
    "build": {
      "provider": "ollama-cloud",
      "modelId": "deepseek-v4-flash:0731",
      "thinking": "high"
    },
    "orchestrator": {
      "provider": "ollama-cloud",
      "modelId": "kimi-k3",
      "thinking": "xhigh"
    },
    "plan": {
      "provider": "ollama-cloud",
      "modelId": "kimi-k3",
      "thinking": "xhigh"
    }
  }
}